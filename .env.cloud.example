# Standalone deployment variables. Copy to .env.cloud and fill in secrets.
#   cp .env.cloud.example .env.cloud
# NEVER commit .env.cloud (it holds real secrets).

# --- Database ---
POSTGRES_USER=biogram
POSTGRES_PASSWORD=CHANGE_ME_16plus_chars
POSTGRES_DB=biogram

# --- App ---
APP_PORT=3100
# min 32 chars. Generate: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48

# --- Public address served by Caddy ---
# IP -> plain HTTP. Domain (DNS A -> server IP) -> automatic HTTPS.
SITE_ADDRESS=115.92.155.58

# --- TWA (Play Store) Digital Asset Links, optional ---
# Play Console → App integrity → App signing key certificate (SHA-256) + package name.
# ASSETLINKS_JSON=[{"relation":["delegate_permission/common.handle_all_urls"],"target":{"namespace":"android_app","package_name":"kr.co.biogram.mini","sha256_cert_fingerprints":["AA:BB:CC"]}}]
ASSETLINKS_JSON=

# --- First-boot admin seed (idempotent; set false after first boot) ---
SEED_ON_START=true
SEED_ADMIN_EMAIL=admin@biogram.co.kr
# 12+ chars, upper/lower/digit/special. Empty in dev only.
SEED_ADMIN_PASSWORD=CHANGE_ME_Admin1234!x
SEED_ADMIN_NAME=최관리
