generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/sqlite-client"
}

datasource db {
  provider = "sqlite"
  url      = env("SQLITE_URL")
}

// ── 기존 키오스크 모델 ──

model KioskContent {
  id        String   @id @default(cuid())
  section   String   @unique
  title     String
  body      String
  imageUrl  String?
  qrCodeUrl String?
  // Screen theme (admin-editable, applied live on kiosk via 5s polling).
  // backgroundColor: hex like #0d9488 (empty = screen default).
  // backgroundImageUrl: cover image URL (empty = none). Takes precedence
  // over backgroundColor when set.
  backgroundColor    String  @default("")
  backgroundImageUrl String?
  // Location map image (location screen "찾아오는 길 지도" block).
  // Admin uploads a map capture; kiosk renders it large and senior-friendly.
  mapImageUrl String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  sections  ContentSection[]
}

// PWA install icons per slot (admin-manageable). isDefault → bundled
// /pwa-icon-*.png files are served; otherwise the uploaded URL is used.
model PwaIcon {
  id        String   @id @default(cuid())
  slot      String   @unique // icon-192, icon-512, maskable-512, apple-180
  url       String
  size      Int
  purpose   String   @default("any") // any | maskable
  isDefault Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

// Uploaded image library with responsive variants. Variants are generated
// at upload time (w640/w1280/w1920, never upscaled) so each kiosk
// environment (mobile 360px → 32" 1080p+) loads a sharp but right-sized file.
model UploadedImage {
  id         String   @id @default(cuid())
  url        String   // largest variant (canonical link stored in content fields)
  filename   String
  width      Int      @default(0)
  height     Int      @default(0)
  mimeType   String   @default("")
  size       Int      @default(0)
  category   String   @default("general")
  variants   String   @default("[]") // JSON: [{url, width}]
  uploadedBy String?
  createdAt  DateTime @default(now())

  @@index([category, createdAt])
}

model KioskLog {
  id        String   @id @default(cuid())
  sessionId String?
  eventType String
  screen    String?
  detail    String?
  createdAt DateTime @default(now())
}

model KioskSession {
  id        String   @id @default(cuid())
  startedAt DateTime @default(now())
  endedAt   DateTime?
}

// ── 관리자 대시보드 모델 ──

model AdminUser {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String
  name            String
  role            String    @default("editor") // superadmin, admin, editor, viewer
  isActive        Boolean   @default(true)
  failedAttempts  Int       @default(0)
  lockedUntil     DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  sessions        AdminSession[]
  auditLogs       AuditLog[]
}

model AdminSession {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MeasurementItem {
  id           String    @id @default(cuid())
  key          String    @unique
  name         String
  description  String    @default("")
  icon         String    @default("")
  color        String    @default("#3B82F6")
  order        Int       @default(0)
  imageUrl     String?
  estimatedTime Int      @default(5)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  equipment    MeasurementEquipment[]
}

model MeasurementEquipment {
  id              String         @id @default(cuid())
  measurementId   String
  name            String
  description     String         @default("")
  preparationSteps String        @default("[]") // JSON string
  precautions     String         @default("[]") // JSON string
  imageUrl        String?
  order           Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  measurement     MeasurementItem @relation(fields: [measurementId], references: [id], onDelete: Cascade)
}

model ContentSection {
  id         String   @id @default(cuid())
  contentId  String
  sectionKey String
  title      String
  body       String   @default("")
  imageUrl   String?
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  content    KioskContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([contentId, sectionKey])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String   // create, update, delete
  entity    String
  entityId  String?
  changes   String   @default("{}") // JSON string
  createdAt DateTime @default(now())
  user      AdminUser? @relation(fields: [userId], references: [id])
}
