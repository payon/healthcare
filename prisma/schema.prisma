generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model KioskContent {
  id        String   @id @default(cuid())
  section   String   @unique
  title     String
  body      String
  imageUrl  String?
  qrCodeUrl String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model KioskLog {
  id        String   @id @default(cuid())
  sessionId String?
  eventType String
  screen    String?
  detail    String?
  createdAt DateTime @default(now())
}

model KioskSession {
  id        String   @id @default(cuid())
  startedAt DateTime @default(now())
  endedAt   DateTime?
}
